def _build_positions_text() -> str:
    if not _db_exists():
        return _pre(["📍 ПОЗИЦИИ", "", "База не найдена."])

    try:
        conn = _db()
        rows = conn.execute(
            """
            SELECT
                symbol,
                direction,
                entry,
                sl,
                tp1,
                tp2,
                tp3,
                size,
                leverage,
                opened_at
            FROM APEX_MASTER_TRADE
            WHERE row_status = 'active'
              AND mode_layer IN ('AUTO','MANUAL')
            ORDER BY id DESC
            LIMIT 5
            """
        ).fetchall()

        cnt_row = conn.execute(
            """
            SELECT COUNT(*) AS cnt
            FROM APEX_MASTER_TRADE
            WHERE row_status = 'active'
              AND mode_layer IN ('AUTO','MANUAL')
            """
        ).fetchone()
        total_open = _safe_int(cnt_row["cnt"] if cnt_row else 0, 0)
        conn.close()

        if not rows:
            return _pre(["📍 ПОЗИЦИИ", "", "Открытых позиций нет."])

        lines = [
            "📍 ПОЗИЦИИ",
            "",
            _line("Открыто сейчас", str(total_open)),
            _line("Показано", str(len(rows))),
        ]

        for i, row in enumerate(rows, start=1):
            direction = "ЛОНГ" if str(row["direction"]).lower() == "long" else "ШОРТ"
            lines.extend([
                "",
                f"{i}. {row['symbol']} [{direction}]",
                _line("Вход", str(row["entry"])),
                _line("Стоп-лосс", str(row["sl"])),
                _line("TP1/TP2/TP3", f"{row['tp1']} / {row['tp2']} / {row['tp3']}"),
                _line("Размер / Плечо", f"{row['size']} / x{row['leverage']}"),
                _line("Открыта", _fmt_dt(row["opened_at"])),
            ])

        if total_open > len(rows):
            lines.extend(["", _line("Ещё позиций", str(total_open - len(rows)))])

        return _pre(lines)

    except Exception as e:
        return _pre(["📍 ПОЗИЦИИ", "", f"Ошибка чтения: {e}"])


