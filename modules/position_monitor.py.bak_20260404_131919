import traceback
from datetime import datetime, timedelta, timezone
from modules.pnl_engine import calculate_pnl
from storage.db.repository import Repository

OPEN_POSITIONS = {}

ENTRY_MIN = 85
OBSERVE_MIN = 30


def _get_session_times(position):
    try:
        session_open = position.get("session_open_time")
        if isinstance(session_open, str):
            session_open = datetime.fromisoformat(session_open.replace("Z", "+00:00"))
        if not session_open:
            return None, None, None

        if session_open.tzinfo is None:
            session_open = session_open.replace(tzinfo=timezone.utc)

        entry_end = session_open + timedelta(minutes=ENTRY_MIN)
        hard_close = entry_end + timedelta(minutes=OBSERVE_MIN)

        return session_open, entry_end, hard_close
    except Exception:
        return None, None, None


def add_position(order: dict):
    symbol = order["symbol"]
    entry = float(order.get("entry_price") or order.get("entry") or 0)
    side = str(order.get("side", "LONG")).upper()

    OPEN_POSITIONS[symbol] = {
        **order,
        "symbol": symbol,
        "side": side,
        "entry": entry,
        "entry_price": entry,
        "opened_at": datetime.now(timezone.utc),
        "status": "open",
        "current_price": entry,
    }


def should_close(position: dict, current_price: float):
    now = datetime.now(timezone.utc)

    session_open, entry_end, hard_close = _get_session_times(position)

    if not session_open:
        return None

    pnl = calculate_pnl({**position, "current_price": current_price})

    if entry_end and now >= entry_end:
        if pnl >= 0:
            return "TIME_EXIT_PROFIT"

    if hard_close and now >= hard_close:
        return "TIME_EXIT_FORCE"

    return None


def close_position(symbol: str, reason: str, price: float):
    pos = OPEN_POSITIONS[symbol]

    close_price = float(price or pos.get("current_price") or pos.get("entry_price") or 0)

    pos["status"] = "closing"
    pos["close_reason"] = reason
    pos["close_price"] = close_price
    pos["closed_at"] = datetime.now(timezone.utc)

    print(f"[PM] CLOSE SIGNAL -> {pos['symbol']} {reason} price={close_price} status=closing")

    # finalizer — единственный источник истины по финансовому закрытию
    # позиция остаётся в OPEN_POSITIONS до удаления через sync_open_positions_with_db


def _save_live_prices():
    try:
        from modules.runtime_state import load_runtime_state, save_runtime_state
        state = load_runtime_state()
        state["live_prices"] = {
            sym: float(pos.get("current_price") or pos.get("entry_price") or 0)
            for sym, pos in OPEN_POSITIONS.items()
        }
        save_runtime_state(state)
    except Exception as e:
        print(f"[POSITION_MONITOR] _save_live_prices error: {e}")


def monitor(prices: dict):
    for symbol, pos in list(OPEN_POSITIONS.items()):
        # пропускаем позиции, уже отправленные на закрытие — ждём sync
        if pos.get("status") == "closing":
            continue

        price = prices.get(symbol)

        if price is None:
            price = pos.get("current_price") or pos.get("entry_price")

        pos["current_price"] = price

        reason = should_close(pos, price)
        if not reason:
            continue

        close_position(symbol, reason, price)
        # НЕ удаляем из OPEN_POSITIONS — sync_open_positions_with_db удалит
        # после подтверждения закрытия в БД (row_status != 'active')

    _save_live_prices()

    return []
