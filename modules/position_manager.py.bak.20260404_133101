"""
APEX PROTOCOL™ — Position Manager
Мониторинг позиций. Пишет в APEX_MASTER_TRADE.
Все timestamps — в UTC.
"""

import json
import logging
from datetime import datetime, timezone
from pathlib import Path
from core.event_bus import EventBus
from core.time_manager import SessionPhase, get_session_phase
from storage.db.repository import Repository
from services.exchange_service import ExchangeService

logger = logging.getLogger("apex.position_manager")


def _utc_now() -> datetime:
    return datetime.now(timezone.utc)


def _utc_now_iso() -> str:
    return _utc_now().replace(tzinfo=None).isoformat()


def _parse_utc_dt(value) -> datetime | None:
    if not value:
        return None
    try:
        if hasattr(value, "isoformat"):
            value = value.isoformat()
        s = str(value).replace("Z", "")
        dt = datetime.fromisoformat(s)
        if dt.tzinfo is not None:
            dt = dt.astimezone(timezone.utc).replace(tzinfo=None)
        return dt
    except Exception:
        return None


class PositionManager:

    def __init__(self, config: dict, event_bus: EventBus):
        self.config = config
        self.event_bus = event_bus
        self.repo = Repository()
        self.exchange = ExchangeService(config)
        self._positions = {}

    async def _ensure_connected(self):
        try:
            await self.exchange.connect()
        except Exception:
            pass

    async def monitor(self, positions: list) -> None:
        try:
            await self._ensure_connected()
            symbols = [p.get("symbol") for p in positions if p.get("symbol")]
            prices = {}

            if symbols:
                try:
                    if not hasattr(self.exchange, "_connected") or not self.exchange._connected:
                        await self.exchange.connect()
                    tickers = await self.exchange.get_tickers(symbols)
                    prices = {
                        sym: tick.get("last")
                        for sym, tick in tickers.items()
                        if tick.get("last")
                    }
                except Exception as e:
                    logger.warning(f"PositionManager: price fetch failed: {e}")

            for position in positions:
                symbol = position.get("symbol")
                if symbol in prices:
                    position["current_price"] = prices[symbol]
                self._positions[symbol] = position
                await self._check_position(position)
                self.repo.log_position(position)

            self._save_live_prices()
            logger.info(f"PositionManager: monitoring {len(self._positions)} positions")
            await self.event_bus.publish(
                "position_manager.update",
                {"positions": list(self._positions.values())},
            )
        except Exception as e:
            logger.error(f"PositionManager error: {e}", exc_info=True)
            try:
                import traceback as _tb
                from storage.db.repository import Repository as _Repo
                _Repo().log_system_event(event="POSITION_MANAGER_ERROR", module="position_manager",
                    message=str(e), level="ERROR", traceback=_tb.format_exc())
            except Exception:
                pass

    async def _check_position(self, position: dict) -> None:
        symbol = position.get("symbol")
        current_price = position.get("current_price", position.get("entry"))
        direction = position.get("direction", "long")

        sl = position.get("sl")
        tp1 = position.get("tp1")
        tp2 = position.get("tp2")
        tp3 = position.get("tp3")

        if not sl or not tp1:
            return

        elapsed_min = None
        opened_at = _parse_utc_dt(position.get("opened_at"))
        if opened_at:
            try:
                elapsed_min = int((_utc_now().replace(tzinfo=None) - opened_at).total_seconds() / 60)
            except Exception:
                elapsed_min = None

        # --- TP hit tracking ---
        self._track_tp_hits(position, current_price, direction, tp1, tp2, tp3)

        if direction == "long":
            if current_price <= sl:
                if elapsed_min is not None and not position.get("minutes_to_sl"):
                    position["minutes_to_sl"] = elapsed_min
                self._apply_protective_stop(position, current_price, "SL")
                await self._close_position(position, "SL")
                return
            elif current_price >= tp3:
                await self._close_position(position, "TP3")
                return
            elif current_price >= tp2:
                self._apply_protective_stop(position, current_price, "TP2")
                await self._close_position(position, "TP2")
                return
            elif current_price >= tp1:
                if elapsed_min is not None and not position.get("minutes_to_tp1"):
                    position["minutes_to_tp1"] = elapsed_min
                if not position.get("breakeven_activated"):
                    self._activate_breakeven(position)
                return
        else:
            if current_price >= sl:
                if elapsed_min is not None and not position.get("minutes_to_sl"):
                    position["minutes_to_sl"] = elapsed_min
                self._apply_protective_stop(position, current_price, "SL")
                await self._close_position(position, "SL")
                return
            elif current_price <= tp3:
                await self._close_position(position, "TP3")
                return
            elif current_price <= tp2:
                self._apply_protective_stop(position, current_price, "TP2")
                await self._close_position(position, "TP2")
                return
            elif current_price <= tp1:
                if elapsed_min is not None and not position.get("minutes_to_tp1"):
                    position["minutes_to_tp1"] = elapsed_min
                if not position.get("breakeven_activated"):
                    self._activate_breakeven(position)
                return

        session_name = position.get("session_name")
        if session_name:
            # --- FORCE_CLOSE_120M: per-position time, NOT global session phase ---
            if position.get("status") == "open":
                hard_close_dt = _parse_utc_dt(position.get("hard_close_time"))
                session_open_dt = _parse_utc_dt(position.get("session_open_time"))
                now_utc = _utc_now().replace(tzinfo=None)

                if hard_close_dt:
                    if now_utc >= hard_close_dt:
                        pos_minutes = int((now_utc - (session_open_dt or opened_at or hard_close_dt)).total_seconds() / 60)
                        position["close_event_type"] = "FORCE_CLOSE_120M"
                        position["result_label"] = "force_close"
                        position["minutes_to_close"] = pos_minutes
                        logger.info(
                            f"FORCE_CLOSE_120M [{session_name}] {symbol}: "
                            f"pos min={pos_minutes} hard_close_time reached — closing"
                        )
                        self._apply_protective_stop(position, current_price, "FORCE_CLOSE_120M")
                        await self._close_position(position, "FORCE_CLOSE_120M")
                        return
                elif session_open_dt:
                    pos_minutes = int((now_utc - session_open_dt).total_seconds() / 60)
                    if pos_minutes >= 120:
                        position["close_event_type"] = "FORCE_CLOSE_120M"
                        position["result_label"] = "force_close"
                        position["minutes_to_close"] = pos_minutes
                        logger.info(
                            f"FORCE_CLOSE_120M [{session_name}] {symbol}: "
                            f"pos min={pos_minutes} (session_open_time+120m) — closing"
                        )
                        self._apply_protective_stop(position, current_price, "FORCE_CLOSE_120M")
                        await self._close_position(position, "FORCE_CLOSE_120M")
                        return
                # else: no hard_close_time and no session_open_time — skip FORCE_CLOSE_120M

            phase, _, minutes_elapsed = get_session_phase(session_name)

            if phase == SessionPhase.OBSERVATION and not position.get("entered_observation"):
                entry = position.get("fill_price") or position.get("entry")
                if entry and current_price:
                    if direction == "long":
                        status_at_90 = (
                            "in_profit" if current_price > entry
                            else ("breakeven" if current_price == entry else "in_loss")
                        )
                    else:
                        status_at_90 = (
                            "in_profit" if current_price < entry
                            else ("breakeven" if current_price == entry else "in_loss")
                        )
                else:
                    status_at_90 = "unknown"

                position["entered_observation"] = True
                position["observation_start_time"] = _utc_now_iso()
                position["status_at_90m"] = status_at_90
                position["minutes_alive_at_90m"] = minutes_elapsed
                logger.info(
                    f"OBSERVATION MODE [{session_name}] {symbol}: "
                    f"status={status_at_90}, session_min={minutes_elapsed}"
                )

        max_minutes = self.config.get("risk", {}).get("max_trade_minutes", 90)
        if opened_at:
            try:
                elapsed = (_utc_now().replace(tzinfo=None) - opened_at).total_seconds() / 60

                if elapsed >= max_minutes:
                    self._apply_protective_stop(position, current_price, "TIMEOUT")
                    await self._close_position(position, "TIMEOUT")
                    return

                if elapsed >= 60:
                    entry = position.get("fill_price") or position.get("entry")
                    if entry and current_price:
                        if direction == "long":
                            in_profit = current_price > entry
                        else:
                            in_profit = current_price < entry
                        if in_profit:
                            self._apply_protective_stop(position, current_price, "TIMEOUT_PROFIT_60")
                            await self._close_position(position, "TIMEOUT_PROFIT_60")
                            return
            except Exception:
                pass

    def _track_tp_hits(self, position: dict, current_price: float,
                       direction: str, tp1, tp2, tp3) -> None:
        """Record timestamps when TP levels are reached for the first time."""
        if direction == "long":
            tp1_hit = tp1 and current_price >= tp1
            tp2_hit = tp2 and current_price >= tp2
            tp3_hit = tp3 and current_price >= tp3
        else:
            tp1_hit = tp1 and current_price <= tp1
            tp2_hit = tp2 and current_price <= tp2
            tp3_hit = tp3 and current_price <= tp3

        now = _utc_now_iso()
        if tp1_hit and not position.get("tp1_hit_at"):
            position["tp1_hit_at"] = now
        if tp2_hit and not position.get("tp2_hit_at"):
            position["tp2_hit_at"] = now
        if tp3_hit and not position.get("tp3_hit_at"):
            position["tp3_hit_at"] = now

    def _apply_protective_stop(self, position: dict, close_price: float,
                               reason: str) -> None:
        """Mark protective stop if closing after TP1+ but not by TP3."""
        if reason == "SL" and not position.get("tp1_hit_at"):
            return  # ordinary SL, no protection triggered
        if reason == "TP3":
            return  # final target, not protective

        # If we had any TP hit — this is a protective stop
        if not position.get("tp1_hit_at"):
            return

        position["protective_stop_hit_at"] = _utc_now_iso()

        entry = float(position.get("fill_price") or position.get("entry") or 0)
        initial_sl = float(position.get("initial_sl") or position.get("sl") or 0)
        sl_dist = abs(entry - initial_sl)
        if sl_dist > 0:
            direction = position.get("direction", "long")
            if direction == "long":
                level_r = (close_price - entry) / sl_dist
            else:
                level_r = (entry - close_price) / sl_dist
            position["protective_stop_level_r"] = round(level_r, 4)

        if position.get("tp2_hit_at"):
            position["protective_stop_reason"] = "TP2_PROTECTION"
        elif position.get("tp1_hit_at"):
            position["protective_stop_reason"] = "TP1_PROTECTION"
        else:
            position["protective_stop_reason"] = "BE_PROTECTION"

    def _activate_breakeven(self, position: dict) -> None:
        symbol = position.get("symbol")
        entry = position.get("fill_price") or position.get("entry")
        position["sl"] = entry
        position["breakeven_activated"] = True
        trade_id = position.get("trade_id")
        if trade_id:
            self.repo.update_position_sl(trade_id, entry)
        logger.info(f"Position {symbol} → breakeven activated: SL moved to entry {entry}")

    async def _close_position(self, position: dict, reason: str) -> None:
        symbol = position.get("symbol")
        position["close_reason"] = reason
        position["closed_at"] = _utc_now_iso()
        position["status"] = "closing"
        logger.info(f"Position {symbol} → closing by {reason}")
        await self.event_bus.publish("position.closing", {"position": position})

    def _save_live_prices(self) -> None:
        try:
            from modules.runtime_state import load_runtime_state, save_runtime_state
            state = load_runtime_state()

            state["live_prices"] = {
                symbol: float(
                    pos.get("current_price")
                    or pos.get("entry")
                    or pos.get("fill_price")
                    or 0
                )
                for symbol, pos in self._positions.items()
                if (
                    pos.get("current_price")
                    or pos.get("entry")
                    or pos.get("fill_price")
                )
            }

            save_runtime_state(state)
        except Exception as e:
            logger.warning(f"PositionManager: save live_prices failed: {e}")

    def get_open_positions(self) -> list:
        return [p for p in self._positions.values() if p.get("status") == "open"]
