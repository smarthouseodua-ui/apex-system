    async def _close_single_position(self, symbol: str, position: dict, reason: str):
        """RC-6: полноценная запись полей закрытия — выровнена с finalizer."""
        now_dt = datetime.now(PODGORICA)
        now = now_dt.strftime("%Y-%m-%dT%H:%M:%S")

        try:
            from storage.db.repository import Repository
            repo = Repository()

            entry = float(position.get("entry") or position.get("fill_price") or 0)
            direction = position.get("direction", "long")
            size = float(position.get("size") or 0)
            exchange_name = str(position.get("exchange_name") or "BYBIT").upper()
            fee_percent = get_fee_rate(exchange_name, "taker")
            commission = fee_percent

            close_price = float(position.get("current_price") or entry)

            # Gross PnL — правильная формула
            if entry and close_price and size:
                if direction.lower() == "long":
                    gross_pnl_usdt = round((close_price - entry) * size, 6)
                else:
                    gross_pnl_usdt = round((entry - close_price) * size, 6)
            else:
                gross_pnl_usdt = 0.0

            # Fees
            fee_rate = commission / 100.0
            fees_open_usdt = abs(entry * size) * fee_rate if (entry and size) else 0.0
            fees_close_usdt = abs(close_price * size) * fee_rate if (close_price and size) else 0.0
            total_fees_usdt = fees_open_usdt + fees_close_usdt
            net_pnl_usdt = round(gross_pnl_usdt - total_fees_usdt, 6)

            notional = abs(entry * size) if (entry and size) else 0
            gross_pnl_pct = round((gross_pnl_usdt / notional) * 100, 4) if notional > 0 else 0.0
            net_pnl_pct = round((net_pnl_usdt / notional) * 100, 4) if notional > 0 else 0.0

            # Duration
            opened_at_str = position.get("opened_at")
            duration_minutes = None
            if opened_at_str:
                try:
                    opened_dt = datetime.fromisoformat(opened_at_str)
                    if opened_dt.tzinfo is None:
                        opened_dt = PODGORICA.localize(opened_dt)
                    duration_minutes = int((now_dt - opened_dt).total_seconds() / 60)
                except Exception:
                    duration_minutes = None

            # close_trigger_side
            close_trigger_side = "LONG" if direction.lower() == "long" else "SHORT"

            # actual_rr / r_multiple — от initial_sl
            sl_val = float(position.get("sl") or 0)
            initial_sl_val = float(position.get("initial_sl") or sl_val or 0)
            sl_dist = abs(entry - initial_sl_val) if (entry and initial_sl_val) else 0
            if sl_dist > 0:
                if direction.lower() == "long":
                    signed_dist = close_price - entry
                else:
                    signed_dist = entry - close_price
                actual_rr = round(signed_dist / sl_dist, 4)
            else:
                actual_rr = None
            r_multiple = actual_rr

            # MFE / MAE approximation
            if entry and close_price:
                if direction.lower() == "long":
                    mfe = round(max(close_price - entry, 0) / entry * 100, 4)
                    mae = round(max(entry - close_price, 0) / entry * 100, 4)
                else:
                    mfe = round(max(entry - close_price, 0) / entry * 100, 4)
                    mae = round(max(close_price - entry, 0) / entry * 100, 4)
            else:
                mfe = 0.0
                mae = 0.0

            # tp_level_reached_max
            reason_upper = (reason or "").upper()
            if reason_upper == "TP3":
                tp_level = 3
            elif reason_upper == "TP2":
                tp_level = 2
            elif reason_upper == "TP1":
                tp_level = 1
            else:
                tp_level = 0

            # exit_reason_text
            _EXIT_TEXT = {
                "SL": "Stop Loss triggered",
                "TP1": "Take Profit 1 reached",
                "TP2": "Take Profit 2 reached",
                "TP3": "Take Profit 3 reached",
                "TIMEOUT": "Position timeout",
                "TIMEOUT_PROFIT_60": "Timeout with profit after 60 min",
                "FORCE_CLOSE_120M": "Forced close at 120 min session limit",
                "TIME_EXIT_PROFIT": "Time-based exit in profit",
                "TIME_EXIT_FORCE": "Time-based forced exit",
                "SESSION_END": "Session ended",
                "SESSION_PROFIT_TAKE": "Session profit take in WATCH phase",
                "EMERGENCY_EXIT": "Emergency exit",
                "MANUAL": "Manual close",
                "MANUAL_STOP": "Manual stop",
                "MANUAL_CLOSE": "Manual close",
            }
            exit_reason_text = _EXIT_TEXT.get(reason_upper, reason)

            repo.log_final_trade({
                "symbol": symbol,
                "direction": direction,
                "strategy": position.get("strategy"),
                "entry": entry,
                "fill_price": entry,
                "close_price": close_price,
                "sl": sl_val,
                "tp1": position.get("tp1"),
                "tp2": position.get("tp2"),
                "tp3": position.get("tp3"),
                "size": size,
                "leverage": position.get("leverage", 1),
                "commission": commission,
                "gross_pnl_usdt": gross_pnl_usdt,
                "gross_pnl_pct": gross_pnl_pct,
                "pnl_pct": net_pnl_pct,
                "pnl_usdt": gross_pnl_usdt,
                "net_pnl_usdt": net_pnl_usdt,
                "net_pnl_pct": net_pnl_pct,
                "fees_open_usdt": fees_open_usdt,
                "fees_close_usdt": fees_close_usdt,
                "total_fees_usdt": total_fees_usdt,
                "close_reason": reason,
                "exit_reason_code": reason,
                "exit_reason_text": exit_reason_text,
                "close_trigger_side": close_trigger_side,
                "actual_rr": actual_rr,
                "r_multiple": r_multiple,
                "max_favorable_excursion_mfe": mfe,
                "max_adverse_excursion_mae": mae,
                "tp_level_reached_max": tp_level,
                "mode": position.get("mode", "simulation"),
                "session_hour": position.get("session_hour"),
                "opened_at": opened_at_str,
                "closed_at": now,
                "finalized_at": now,
                "trade_id": position.get("trade_id"),
                "session_name": position.get("session_name"),
                "duration_minutes": duration_minutes,
                "minutes_to_close": duration_minutes,
                "strategy_name": position.get("strategy_name") or self.config.get("active_filter"),
            })

        except Exception as e:
            logger.error(f"_close_single_position({symbol}) error: {e}", exc_info=True)

    async def _close_profitable_positions(self, session: str = ""):
        if not self._open_positions:
            return

        try:
            to_close = []
            for symbol, pos in self._open_positions.items():
                entry = pos.get("entry") or pos.get("fill_price")
                direction = pos.get("direction", "long")
                current_price = pos.get("current_price") or entry

                if not current_price or not entry:
                    continue

                if direction == "long":
                    pnl_pct = ((current_price - entry) / entry) * 100
                else:
                    pnl_pct = ((entry - current_price) / entry) * 100

                if pnl_pct > 0:
                    logger.info(f"WATCH [{session}]: closing {symbol} in profit +{pnl_pct:.2f}%")
                    to_close.append(symbol)

            for symbol in to_close:
                pos = self._open_positions.pop(symbol)
                await self._close_single_position(symbol, pos, "SESSION_PROFIT_TAKE")

            if to_close:
                logger.info(f"WATCH [{session}]: closed {len(to_close)} profitable positions")

        except Exception as e:
            logger.error(f"_close_profitable_positions error: {e}", exc_info=True)

