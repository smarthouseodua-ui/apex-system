"""
APEX PROTOCOL™ — Core Orchestrator
Главный координатор торгового пайплайна.
Запускает, останавливает и контролирует все модули.

Сессионная модель (session_engine.py):
- ВХОД:        0–90 мин сессии — полный pipeline (scan → execute)
- СОПРОВОЖДЕНИЕ: 90–120 мин — мониторинг и закрытие
- ПОДГОТОВКА:  за 30 мин до открытия — SMC-анализ
- OFF:         вне всех сессий — закрыть всё
"""

import asyncio
import logging
import time
from datetime import datetime
from pytz import timezone as tz

PODGORICA = tz("Europe/Podgorica")
from core.time_manager import TimeManager
from core.session_engine import get_phase_for_orchestrator
from core.state_manager import StateManager
from core.event_bus import EventBus
from core.id_manager import IdManager
from modules.position_monitor import monitor as position_monitor

logger = logging.getLogger("apex.orchestrator")


class Orchestrator:

    def __init__(self, config: dict):
        self.config = config
        self.running = False

        # Ядро
        self.time_manager = TimeManager(config)
        self.state_manager = StateManager()
        self.event_bus = EventBus()
        self.id_manager = IdManager()

        # Модули (инициализируются в setup)
        self.scanner = None
        self.strategy_engine = None
        self.signal_gate = None
        self.risk_manager = None
        self.execution_engine = None
        self.position_manager = None
        self.finalizer = None

        # Открытые позиции: symbol → position dict
        self._open_positions: dict[str, dict] = {}
        self._pre_session_done = {}

        logger.info("Orchestrator initialized")

    async def setup(self):
        """Инициализация всех модулей."""
        from modules.scanner import Scanner
        from modules.strategy_engine import StrategyEngine
        from modules.signal_gate import SignalGate
        from modules.position_manager import PositionManager
        from modules.finalizer import Finalizer
        from modules.pre_session_smc import PreSessionAnalyzer
        from storage.db.repository import Repository

        self.scanner = Scanner(self.config, self.event_bus)
        self.strategy_engine = StrategyEngine(self.config, self.event_bus)
        self.signal_gate = SignalGate(self.config, self.event_bus)
        self.position_manager = PositionManager(self.config, self.event_bus)
        self.finalizer = Finalizer(self.config, self.event_bus)

        self._repo = Repository()
        self.pre_session = PreSessionAnalyzer(self.config, self.scanner.exchange_service, self._repo)

        logger.info("All modules initialized")

    async def _load_open_positions(self):
        """Загружает открытые позиции из БД при старте (восстановление после рестарта)."""
        try:
            from storage.db.repository import Repository
            repo = Repository()
            positions = repo.get_open_positions()
            for p in positions:
                self._open_positions[p["symbol"]] = p
            if positions:
                logger.info(
                    f"Restored {len(positions)} open positions from DB: "
                    f"{[p['symbol'] for p in positions]}"
                )
            else:
                logger.info("No open positions in DB to restore")
        except Exception as e:
            logger.error(f"_load_open_positions error: {e}", exc_info=True)

    async def _close_all_session_end(self, reason: str = "SESSION_END"):
        """Принудительное закрытие всех открытых позиций."""
        if not self._open_positions:
            return
        symbols = list(self._open_positions.keys())
        for symbol in symbols:
            pos = self._open_positions.pop(symbol, None)
            if pos:
                await self._close_single_position(symbol, pos, reason)
        logger.info(f"{reason}: closed {len(symbols)} positions — {symbols}")

    def _tc_scanner_enabled(self) -> bool:
        """Читает scanner_enabled из test_control.json. Если файл недоступен — True."""
        try:
            from services.test_control import read as tc_read
            return tc_read().get("scanner_enabled", True)
        except Exception:
            return True

    async def run(self):
        """Главный цикл пайплайна."""
        await self.setup()
        await self._load_open_positions()

        now = datetime.now(PODGORICA)
        test_mode = self.config.get("_hourly_test", False)
        logger.info(f"Pipeline 24/7 mode — start at {now.hour}:{now.minute:02d}")

        self.running = True
        self.state_manager.set_state("running")
        logger.info(f"Pipeline started at {datetime.now(PODGORICA)}")

        _was_scanner_on = True

        try:
            while self.running:
                scanner_on = self._tc_scanner_enabled()

                # Если scanner выключен — войти в режим ожидания
                if not scanner_on:
                    if _was_scanner_on:
                        logger.info("test_control: scanner_enabled=False — closing positions, entering idle mode")
                        if self._open_positions:
                            await self._close_all_session_end(reason="MANUAL_STOP")
                        _was_scanner_on = False
                    await asyncio.sleep(self.config.get("cycle_interval", 60))
                    continue

                # Scanner включён — возобновляем работу
                if not _was_scanner_on:
                    logger.info("test_control: scanner_enabled=True — resuming pipeline")
                _was_scanner_on = True

                # Ресинк _hourly_test из test_control (может измениться после Stop → Start)
                try:
                    from services.test_control import read as tc_read
                    _tc = tc_read()
                    if _tc.get("hourly_test_enabled"):
                        self.config["_hourly_test"] = True
                        test_mode = True
                    else:
                        self.config.pop("_hourly_test", None)
                        test_mode = False
                except Exception:
                    pass

                await self._run_cycle()
                await asyncio.sleep(self.config.get("cycle_interval", 60))
        except asyncio.CancelledError:
            logger.info("Pipeline cancelled")
        except Exception as e:
            logger.error(f"Pipeline error: {e}", exc_info=True)
        finally:
            await self.stop()

    async def _run_cycle(self):
        """Один цикл пайплайна: Scanner → ... → Finalizer."""
        cycle_id = self.id_manager.next_cycle_id()
        start_time = time.time()
        logger.info(f"[{cycle_id}] Cycle start")

        # --- Определяем фазу через session_engine ---
        phase, session, raw_phase = get_phase_for_orchestrator()
        logger.info(f"[{cycle_id}] Session: {session} | Phase: {phase} ({raw_phase})")

        # --- PRE_SESSION SMC analysis ---
        if phase == "PRE_SESSION":
            if not self._pre_session_done.get(session):
                logger.info(f"[{cycle_id}] ПОДГОТОВКА: SMC-анализ для {session}")
                try:
                    await self.scanner._ensure_connected()
                    await self.pre_session.analyze(session)
                    self._pre_session_done[session] = True
                except Exception as e:
                    logger.error(f"[{cycle_id}] PRE_SESSION analysis failed: {e}")
            return

        # --- OFF: вне всех сессий ---
        if phase == "OFF":
            if self._open_positions:
                logger.info(f"Session OFF: closing all {len(self._open_positions)} positions")
                await self._close_all_session_end(reason="SESSION_END")
            return

        # --- WATCH: СОПРОВОЖДЕНИЕ / ПОЗДНЯЯ ФАЗА — только мониторинг ---
        if phase == "WATCH":
            if self._open_positions:
                open_list = list(self._open_positions.values())
                await self.position_manager.monitor(open_list)
                await self.finalizer.finalize(open_list)
                self._open_positions = {
                    s: p for s, p in self._open_positions.items()
                    if p.get("status") == "open"
                }
            await self._close_profitable_positions(session)
            return

        # --- ENTRY (ВХОД): полный pipeline ---
        try:
            # --- Сброс состояния SignalGate ---
            self.signal_gate.reset(session_name=session)

            # --- Мониторинг существующих открытых позиций ---
            if self._open_positions:
                open_list = list(self._open_positions.values())
                await self.position_manager.monitor(open_list)
                await self.finalizer.finalize(open_list)
                # Убираем закрытые/closing из трекинга
                self._open_positions = {
                    s: p for s, p in self._open_positions.items()
                    if p.get("status") == "open"
                }
                logger.info(
                    f"[{cycle_id}] Open positions after monitor: {len(self._open_positions)}"
                )

            # --- Position monitor (simulation) ---
            candidates = await self.scanner.scan()
            if candidates:
                current_prices = {
                    c["symbol"]: c["price"]
                    for c in candidates if c.get("price")
                }
                from modules.position_monitor import OPEN_POSITIONS as MON_POS
                from modules.execution_engine import OPEN_POSITIONS as EE_POS
                logger.info(f"[MONITOR] mon={len(MON_POS)} ee={len(EE_POS)} prices={len(current_prices)} mon_keys={list(MON_POS.keys())[:3]}")
                closed = position_monitor(current_prices)
                if closed:
                    logger.info(f"[MONITOR] Closed {len(closed)} positions")

            # --- Новые сигналы ---
            if not candidates:
                logger.info("[PIPELINE] No candidates — cycle skipped")
                return

            # Исключаем уже открытые символы ДО strategy engine
            # Union: память + DB — защита от расхождения после рестарта/крэша
            open_syms = set(self._open_positions.keys())
            try:
                from storage.db.repository import Repository
                db_open = Repository().get_open_symbols()
                if db_open - open_syms:
                    logger.warning(
                        f"[{cycle_id}] DB/memory mismatch — DB extra: {db_open - open_syms}"
                    )
                open_syms = open_syms | db_open
            except Exception as e:
                logger.error(f"[{cycle_id}] DB open_symbols check failed: {e}")
            new_candidates = [c for c in candidates if c.get("symbol") not in open_syms]
            logger.info(
                f"[{cycle_id}] Candidates: {len(candidates)} total, "
                f"{len(candidates) - len(new_candidates)} already open, "
                f"{len(new_candidates)} new"
            )
            if not new_candidates:
                logger.info(f"[{cycle_id}] All candidates already open — skip strategy")
                return

            signals = await self.strategy_engine.analyze(new_candidates)
            if not signals:
                return

            # Передаём текущие открытые символы в SignalGate
            approved = await self.signal_gate.filter(
                signals, open_symbols=set(self._open_positions.keys())
            )
            if not approved:
                logger.info("[PIPELINE] No approved signals — cycle completed without entries")
                return

            logger.info(f"[{cycle_id}] Approved signals: {len(approved)}")

            duration = round(time.time() - start_time, 2)
            logger.info(f"[PIPELINE] Cycle duration: {duration}s")
            logger.info("[PIPELINE] Cycle completed")

        except Exception as e:
            logger.error(f"[{cycle_id}] Cycle error: {e}", exc_info=True)

    async def _close_single_position(self, symbol: str, position: dict, reason: str):
        """Закрывает одну позицию: обновляет T05, записывает T07."""
        now_dt = datetime.now(PODGORICA)
        now = now_dt.strftime("%Y-%m-%dT%H:%M:%S")
        try:
            from storage.db.repository import Repository
            repo = Repository()

            entry = position.get("entry") or position.get("fill_price") or 0
            direction = position.get("direction", "long")
            size = position.get("size", 0)
            size_usdt = position.get("size_usdt") or position.get("risk_usdt") or 0

            row = repo.conn.execute(
                "SELECT current_price FROM SKL01_T06_position_manager_log "
                "WHERE symbol=? ORDER BY id DESC LIMIT 1",
                (symbol,)
            ).fetchone()
            close_price = (row[0] if row and row[0] else None) or position.get("current_price") or entry

            if entry and close_price:
                if direction == "long":
                    pnl_pct = ((close_price - entry) / entry) * 100
                else:
                    pnl_pct = ((entry - close_price) / entry) * 100
                pnl_usdt = round((size_usdt or size * entry) * (pnl_pct / 100), 4)
            else:
                pnl_pct = 0.0
                pnl_usdt = 0.0

            opened_at_str = position.get("opened_at")
            duration_minutes = None
            if opened_at_str:
                try:
                    opened_dt = datetime.fromisoformat(opened_at_str)
                    if opened_dt.tzinfo is None:
                        opened_dt = PODGORICA.localize(opened_dt)
                    duration_minutes = int((now_dt - opened_dt).total_seconds() / 60)
                except Exception:
                    duration_minutes = None

            repo.conn.execute(
                "UPDATE SKL01_T05_execution_log SET status='closed' "
                "WHERE symbol=? AND status='open'",
                (symbol,)
            )

            repo.log_final_trade({
                "symbol": symbol,
                "direction": direction,
                "strategy": position.get("strategy"),
                "entry": entry,
                "close_price": close_price,
                "sl": position.get("sl"),
                "tp1": position.get("tp1"),
                "tp2": position.get("tp2"),
                "tp3": position.get("tp3"),
                "size": size,
                "leverage": position.get("leverage", 1),
                "pnl_pct": round(pnl_pct, 4),
                "pnl_usdt": pnl_usdt,
                "close_reason": reason,
                "mode": position.get("mode", "simulation"),
                "session_hour": position.get("session_hour"),
                "opened_at": opened_at_str,
                "closed_at": now,
                "finalized_at": now,
                "trade_id": position.get("trade_id"),
                "session_name": position.get("session_name"),
                "duration_minutes": duration_minutes,
                "minutes_to_close": duration_minutes,
                "strategy_name": position.get("strategy_name") or self.config.get("active_filter"),
            })
        except Exception as e:
            logger.error(f"_close_single_position({symbol}) error: {e}", exc_info=True)

    async def _close_profitable_positions(self, session: str = ""):
        """WATCH phase: закрывает только позиции в плюсе."""
        if not self._open_positions:
            return
        try:
            from storage.db.repository import Repository
            repo = Repository()
            to_close = []
            for symbol, pos in self._open_positions.items():
                entry = pos.get("entry") or pos.get("fill_price")
                direction = pos.get("direction", "long")
                row = repo.conn.execute(
                    "SELECT current_price FROM SKL01_T06_position_manager_log "
                    "WHERE symbol=? ORDER BY id DESC LIMIT 1",
                    (symbol,)
                ).fetchone()
                current_price = (row[0] if row and row[0] else None) or pos.get("current_price") or entry
                if not current_price or not entry:
                    continue
                if direction == "long":
                    pnl_pct = ((current_price - entry) / entry) * 100
                else:
                    pnl_pct = ((entry - current_price) / entry) * 100
                if pnl_pct > 0:
                    logger.info(f"WATCH [{session}]: closing {symbol} in profit +{pnl_pct:.2f}%")
                    to_close.append(symbol)
            for symbol in to_close:
                pos = self._open_positions.pop(symbol)
                await self._close_single_position(symbol, pos, "SESSION_PROFIT_TAKE")
            if to_close:
                logger.info(f"WATCH [{session}]: closed {len(to_close)} profitable positions")
        except Exception as e:
            logger.error(f"_close_profitable_positions error: {e}", exc_info=True)

    async def stop(self):
        """Остановка пайплайна."""
        self.running = False
        self.state_manager.set_state("stopped")
        # Закрываем exchange соединения — предотвращаем утечку aiohttp
        try:
            if self.scanner and self.scanner.exchange_service:
                await self.scanner.exchange_service.close()
                logger.info("ExchangeService: connection closed on stop")
        except Exception as e:
            logger.warning(f"ExchangeService close error: {e}")
        logger.info("Pipeline stopped")
