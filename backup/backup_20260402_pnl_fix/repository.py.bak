"""
APEX PROTOCOL™ — Repository
Запись и чтение данных из SQLite таблиц APEX_MASTER.
"""

import json
import sqlite3
import logging
from datetime import datetime
from storage.db.init_db import get_connection
from core.time_manager import time_features_for_dt

logger = logging.getLogger("apex.repository")


class Repository:
    def __init__(self):
        self.conn = get_connection()

    def log_scanner(self, candidate: dict):
        reason_tags = candidate.get("reason_tags")
        if isinstance(reason_tags, list):
            reason_tags = ",".join(reason_tags)

        raw_json = candidate.get("raw_json")
        if raw_json is None:
            try:
                raw_json = json.dumps(candidate, ensure_ascii=False, default=str)
            except Exception:
                raw_json = "{}"

        self.conn.execute("""
            INSERT INTO APEX_MASTER_SCANNER
            (
                symbol, price, volume, volatility, session, scanned_at,
                scan_run_id, score, candidate_status, trend, ema, distance_to_ema,
                is_premium_zone, is_discount_zone, is_equilibrium_zone,
                bos, choch, liq_sweep, fvg, ob,
                reason_tags, raw_json, strategy_name
            )
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        """, (
            candidate.get("symbol"),
            candidate.get("price"),
            candidate.get("volume"),
            candidate.get("volatility"),
            candidate.get("session", ""),
            candidate.get("scanned_at", datetime.now().isoformat()),
            candidate.get("scan_run_id"),
            candidate.get("score"),
            candidate.get("candidate_status"),
            candidate.get("trend"),
            candidate.get("ema"),
            candidate.get("distance_to_ema"),
            candidate.get("is_premium_zone"),
            candidate.get("is_discount_zone"),
            candidate.get("is_equilibrium_zone"),
            candidate.get("bos"),
            candidate.get("choch"),
            candidate.get("liq_sweep"),
            candidate.get("fvg"),
            candidate.get("ob"),
            reason_tags,
            raw_json,
            candidate.get("strategy_name"),
        ))
        self.conn.commit()

    def log_strategy(self, signal: dict):
        try:
            self.conn.execute("""
                UPDATE APEX_MASTER_TRADE SET
                    market_phase      = ?,
                    bos_present       = ?,
                    choch_present     = ?,
                    entry_in_discount = ?,
                    entry_near_ob     = ?,
                    entry_near_fvg    = ?
                WHERE trade_id = ?
            """, (
                signal.get("market_phase"),
                signal.get("bos_present"),
                signal.get("choch_present"),
                signal.get("entry_in_discount"),
                signal.get("entry_near_ob"),
                signal.get("entry_near_fvg"),
                signal.get("trade_id"),
            ))
            self.conn.commit()
        except Exception as e:
            logger.error(f"APEX_MASTER_TRADE update (strategy) error: {e}")

    def log_signal_gate(self, symbol: str, reject_reason_stage: str, reject_reason_code: str, reject_reason_text: str, cycle_id: str = None):
        try:
            # Попытка 1: обновить открытую trade-запись если она уже есть
            cursor = self.conn.execute("""
                UPDATE APEX_MASTER_TRADE SET
                    reject_reason_stage = ?,
                    reject_reason_code = ?,
                    reject_reason_text = ?,
                    updated_at = ?
                WHERE symbol = ? AND closed_at IS NULL
            """, (reject_reason_stage, reject_reason_code, reject_reason_text, datetime.now().isoformat(), symbol))
            self.conn.commit()

            # Попытка 2: всегда писать в APEX_MASTER_ERRORS — это основной путь при reject ДО создания сделки
            self.log_system_event(
                event="SIGNAL_GATE_REJECT",
                module="signal_gate",
                message=f"[{reject_reason_stage}] {reject_reason_code}: {reject_reason_text}",
                level="INFO",
                cycle_id=cycle_id,
                traceback=f"symbol={symbol}",
            )
        except Exception as e:
            self.log_system_event(
                event="LOG_SIGNAL_GATE_ERROR",
                module="repository",
                message=str(e),
                level="ERROR",
            )

    def log_risk_manager(self, order: dict):
        try:
            self.conn.execute("""
                UPDATE APEX_MASTER_TRADE SET
                    risk_pct = ?,
                    risk_usdt = ?,
                    rr = ?
                WHERE trade_id = ?
            """, (
                order.get("risk_pct"),
                order.get("risk_usdt"),
                order.get("rr"),
                order.get("trade_id"),
            ))
            self.conn.commit()
        except Exception as e:
            logger.error(f"APEX_MASTER_TRADE update (risk) error: {e}")


    def log_execution(self, position: dict):
        if not position.get('source_pipeline'):
            position['source_pipeline'] = 'apex-pipeline'
        if not position.get('event_context'):
            position['event_context'] = 'NONE'

        now = datetime.utcnow().isoformat()
        opened_at = position.get("opened_at", now)
        mode = position.get("mode", "simulation")
        entry_type = "SIMULATED" if mode.upper() in ("PAPER", "SIMULATION") else "LIVE"

        # Session engine — иерархия:
        #   1) upstream session_name (если валидный и не OFF)
        #   2) MANUAL — если mode=MANUAL
        #   3) авто-расчёт по UTC: ASIA 00-08, LONDON 08-13, NEW_YORK 13-21, OFF 21-00
        raw_session_name = position.get("session_name")
        raw_session_name = str(raw_session_name).strip() if raw_session_name else ""

        def _calc_session_by_utc(dt_str):
            """Вычислить сессию по UTC-часу открытия."""
            try:
                from datetime import datetime as _dt
                if isinstance(dt_str, str):
                    ts = _dt.fromisoformat(dt_str.replace("Z", "+00:00"))
                else:
                    ts = dt_str
                h = ts.hour
            except Exception:
                h = datetime.utcnow().hour
            if 0 <= h < 8:
                return "ASIA"
            elif 8 <= h < 13:
                return "LONDON"
            elif 13 <= h < 21:
                return "NEW_YORK"
            return "OFF"

        try:
            if raw_session_name and raw_session_name.upper() not in ("OFF", ""):
                # Приоритет 1: валидный upstream session_name
                session_name = raw_session_name
                overlap_flag = 1 if (
                    "OVERLAP" in session_name.upper()
                    or session_name.upper() in ("ASIA+HK", "ASIA+HONG_KONG", "LONDON,NEW_YORK")
                ) else 0
            elif mode.upper() == "MANUAL":
                # Приоритет 2: ручной режим
                session_name = "MANUAL"
                overlap_flag = 0
            else:
                # Приоритет 3: авто-расчёт по opened_at UTC
                try:
                    tf = time_features_for_dt(opened_at)
                    session_name = tf.get("session_name", "") or ""
                    # time_manager может вернуть OFF — пересчитаем
                    if not session_name or session_name.upper() == "OFF":
                        session_name = _calc_session_by_utc(opened_at)
                    overlap_flag = 1 if (
                        tf.get("event_overlap_london_ny", 0) or
                        tf.get("event_overlap_asia_hk", 0)
                    ) else 0
                except Exception:
                    session_name = _calc_session_by_utc(opened_at)
                    overlap_flag = 0
        except Exception:
            session_name = raw_session_name if raw_session_name else _calc_session_by_utc(opened_at)
            overlap_flag = 0

        session_group = self._calc_session_group(session_name)
        sub_session = session_name or "UNKNOWN"

        if session_group == "EUROPE":
            session_anchor = "EUROPE"
        elif session_group == "AMERICA":
            session_anchor = "NEW_YORK"
        elif session_group == "ASIA" and sub_session == "HONG_KONG":
            session_anchor = "HONG_KONG"
        elif session_group == "ASIA":
            session_anchor = "ASIA"
        else:
            session_anchor = "UNKNOWN"

        if overlap_flag == 1 and session_group == "EUROPE":
            session_state = "EUROPE+NEW_YORK"
        elif overlap_flag == 1 and session_group == "AMERICA":
            session_state = "NEW_YORK+ASIA"
        elif overlap_flag == 1 and session_group == "ASIA" and sub_session == "HONG_KONG":
            session_state = "ASIA+HONG_KONG"
        elif session_group == "EUROPE":
            session_state = "EUROPE"
        elif session_group == "AMERICA":
            session_state = "NEW_YORK"
        elif session_group == "ASIA" and sub_session == "HONG_KONG":
            session_state = "ASIA+HONG_KONG"
        elif session_group == "ASIA":
            session_state = "ASIA"
        else:
            session_state = "UNKNOWN"

        session_phase = "ENTRY"

        params = {
            "trade_id": position.get("trade_id"),
            "symbol": position.get("symbol"),
            "direction": position.get("direction"),
            "strategy": position.get("strategy", "APEX_ORB"),
            "source_pipeline": position.get("source_pipeline"),
            "mode": mode,
            "session_name": session_name,
            "session_group": session_group,
            "sub_session": sub_session,
            "session_hour": position.get("session_hour") or int(opened_at[11:13]) if opened_at and len(opened_at) >= 13 else None,
            "pre_session_flag": position.get("pre_session_flag", 0),
            "event_context": position.get("event_context") or "NORMAL",
            "session_open_minutes_from_start": position.get("session_open_minutes_from_start"),
            "overlap_flag": overlap_flag,
            "session_date_key": opened_at[:10] if opened_at and len(opened_at) >= 10 else None,
            "opened_at": opened_at,
            "created_at": opened_at,
            "opened_date": opened_at[:10] if opened_at and len(opened_at) >= 10 else None,
            "opened_hour": int(opened_at[11:13]) if opened_at and len(opened_at) >= 13 else None,
            "trade_day_of_week": self._calc_day_of_week(opened_at),
            "entry": position.get("fill_price"),
            "sl": position.get("sl"),
            "tp1": position.get("tp1"),
            "tp2": position.get("tp2"),
            "tp3": position.get("tp3"),
            "size": position.get("size"),
            "leverage": position.get("leverage"),
            "fill_price": position.get("fill_price"),
            "risk_pct": position.get("risk_pct"),
            "account_balance_snapshot": position.get("account_balance_snapshot"),
            "risk_model_name": position.get("risk_model_name"),
            "risk_per_trade_pct_plan": position.get("risk_per_trade_pct_plan"),
            "risk_per_trade_usdt_plan": position.get("risk_per_trade_usdt_plan"),
            "risk_compliance_flag": position.get("risk_compliance_flag", "OK"),
            "risk_usdt": position.get("risk_usdt"),
            "rr": position.get("rr"),
            "slippage": position.get("slippage", 0),
            "entry_delay_sec": position.get("entry_delay_sec", 0),
            "entry_type": entry_type,
            "entry_distance_to_sl_pct": self._calc_distance_pct(position.get("fill_price"), position.get("sl")),
            "entry_distance_to_tp1_pct": self._calc_distance_pct(position.get("fill_price"), position.get("tp1")),
            "commission": position.get("commission", 0.03),
            "scanner_passed": 1,
            "filter_passed": 1,
            "execution_attempted": 1,
            "execution_success": 1,
            "entry_signal_score": position.get("entry_signal_score"),
            "scanner_score": position.get("scanner_score"),
            "filter_score": position.get("filter_score"),
            "confidence_score": position.get("confidence_score"),
            "setup_grade": position.get("setup_grade"),
            "entry_quality_flag": position.get("entry_quality_flag"),
            "entry_reason_code": position.get("entry_reason_code"),
            "entry_reason_text": position.get("entry_reason_text"),
            "exchange_name": position.get("exchange_name", "Bybit"),
            "strategy_family": position.get("strategy_family", "APEX"),
            "strategy_version": position.get("strategy_version", "v1.0"),
            "setup_name": position.get("setup_name"),
            "setup_variant": position.get("setup_variant"),
            "updated_at": opened_at,
            "market_type": position.get("market_type", "FUTURES"),
            "instrument_type": position.get("instrument_type", "PERPETUAL"),
            "calc_version": position.get("calc_version", "v1.0"),
            "dashboard_note": position.get("dashboard_note"),
            "tick_size": position.get("tick_size"),
            "step_size": position.get("step_size"),
            "min_notional": position.get("min_notional"),
            "market_phase": position.get("market_phase"),
            "bos_present": position.get("bos_present", 0),
            "choch_present": position.get("choch_present", 0),
            "entry_in_discount": position.get("entry_in_discount", 0),
            "entry_near_ob": position.get("entry_near_ob", 0),
            "entry_near_fvg": position.get("entry_near_fvg", 0),
            "orb_high": position.get("orb_high"),
            "orb_low": position.get("orb_low"),
            "orb_mid": position.get("orb_mid"),
            "retest_price": position.get("retest_price"),
            "row_status": "active",
            "data_quality_flag": "OK",
            "analytics_ready_flag": 0,
            "dashboard_group_date": opened_at[:10] if opened_at and len(opened_at) >= 10 else None,
            "dashboard_sort_ts": opened_at,
            "is_visible_in_dashboard": 1,
            "session_anchor": session_anchor,
            "session_state": session_state,
            "session_phase": session_phase,
            "mode_layer": (
                # manual_entry_enabled пайплайн: session_name=MANUAL, но mode!=MANUAL
                # → классифицируем как AUTO по реальной UTC-сессии
                "AUTO" if (session_name or "").upper() == "MANUAL" and mode.upper() != "MANUAL"
                else "MANUAL" if (session_name or "").upper() == "MANUAL"
                else "AUTO" if (session_name or "").upper() in ("ASIA", "LONDON", "NEW_YORK")
                else "HISTORICAL" if (session_name or "").upper() in ("OFF", "TEST")
                else "UNKNOWN"
            ),
        }

        try:
            self.conn.execute("""
                INSERT INTO APEX_MASTER_TRADE (
                    trade_id,
                    symbol,
                    direction,
                    strategy,
                    source_pipeline,
                    mode,
                    session_name,
                    session_group,
                    sub_session,
                    session_hour,
                    pre_session_flag,
                    event_context,
                    session_open_minutes_from_start,
                    overlap_flag,
                    session_date_key,
                    opened_at,
                    created_at,
                    opened_date,
                    opened_hour,
                    trade_day_of_week,
                    entry,
                    sl,
                    tp1,
                    tp2,
                    tp3,
                    size,
                    leverage,
                    fill_price,
                    risk_pct,
                    account_balance_snapshot,
                    risk_model_name,
                    risk_per_trade_pct_plan,
                    risk_per_trade_usdt_plan,
                    risk_compliance_flag,
                    risk_usdt,
                    rr,
                    slippage,
                    entry_delay_sec,
                    entry_type,
                    entry_distance_to_sl_pct,
                    entry_distance_to_tp1_pct,
                    commission,
                    scanner_passed,
                    filter_passed,
                    execution_attempted,
                    execution_success,
                    entry_signal_score,
                    scanner_score,
                    filter_score,
                    confidence_score,
                    setup_grade,
                    entry_quality_flag,
                    entry_reason_code,
                    entry_reason_text,
                    exchange_name,
                    strategy_family,
                    strategy_version,
                    setup_name,
                    setup_variant,
                    updated_at,
                    market_type,
                    instrument_type,
                    calc_version,
                    dashboard_note,
                    tick_size,
                    step_size,
                    min_notional,
                    market_phase,
                    bos_present,
                    choch_present,
                    entry_in_discount,
                    entry_near_ob,
                    entry_near_fvg,
                    orb_high,
                    orb_low,
                    orb_mid,
                    retest_price,
                    row_status,
                    data_quality_flag,
                    analytics_ready_flag,
                    dashboard_group_date,
                    dashboard_sort_ts,
                    is_visible_in_dashboard,
                    session_anchor,
                    session_state,
                    session_phase,
                    mode_layer
                ) VALUES (
                    :trade_id,
                    :symbol,
                    :direction,
                    :strategy,
                    :source_pipeline,
                    :mode,
                    :session_name,
                    :session_group,
                    :sub_session,
                    :session_hour,
                    :pre_session_flag,
                    :event_context,
                    :session_open_minutes_from_start,
                    :overlap_flag,
                    :session_date_key,
                    :opened_at,
                    :created_at,
                    :opened_date,
                    :opened_hour,
                    :trade_day_of_week,
                    :entry,
                    :sl,
                    :tp1,
                    :tp2,
                    :tp3,
                    :size,
                    :leverage,
                    :fill_price,
                    :risk_pct,
                    :account_balance_snapshot,
                    :risk_model_name,
                    :risk_per_trade_pct_plan,
                    :risk_per_trade_usdt_plan,
                    :risk_compliance_flag,
                    :risk_usdt,
                    :rr,
                    :slippage,
                    :entry_delay_sec,
                    :entry_type,
                    :entry_distance_to_sl_pct,
                    :entry_distance_to_tp1_pct,
                    :commission,
                    :scanner_passed,
                    :filter_passed,
                    :execution_attempted,
                    :execution_success,
                    :entry_signal_score,
                    :scanner_score,
                    :filter_score,
                    :confidence_score,
                    :setup_grade,
                    :entry_quality_flag,
                    :entry_reason_code,
                    :entry_reason_text,
                    :exchange_name,
                    :strategy_family,
                    :strategy_version,
                    :setup_name,
                    :setup_variant,
                    :updated_at,
                    :market_type,
                    :instrument_type,
                    :calc_version,
                    :dashboard_note,
                    :tick_size,
                    :step_size,
                    :min_notional,
                    :market_phase,
                    :bos_present,
                    :choch_present,
                    :entry_in_discount,
                    :entry_near_ob,
                    :entry_near_fvg,
                    :orb_high,
                    :orb_low,
                    :orb_mid,
                    :retest_price,
                    :row_status,
                    :data_quality_flag,
                    :analytics_ready_flag,
                    :dashboard_group_date,
                    :dashboard_sort_ts,
                    :is_visible_in_dashboard,
